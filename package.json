{
  "name": "home-app-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:prod": "vite --mode production",
    "build": "tsc -b && vite build",
    "dev:matchmaking": "vite --config vite.matchmaking.config.ts",
    "dev:matchmaking:prod": "vite --config vite.matchmaking.config.ts --mode production",
    "build:matchmaking": "tsc -b && vite build --config vite.matchmaking.config.ts",
    "preview:matchmaking": "vite preview --config vite.matchmaking.config.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate-api": "openapi-zod-client ./openapi/index.yaml -o ./src/api/generated.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@tanstack/react-query": "^5.90.19",
    "@zodios/core": "^10.9.6",
    "antd": "^5.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "openapi-zod-client": "^1.18.3",
    "sass-embedded": "^1.85.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.4.1"
  }
}
