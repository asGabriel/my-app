# Carregado quando o Vite roda com --mode production (ex.: npm run dev:prod).
# Aponta o proxy /api do dev server para a API de produção, sem precisar
# editar o .env local de cada um.
VITE_API_URL=https://rust-api-h0m0.onrender.com

# Contra a API de produção a sessão fake do mock (ver src/finance/mock/config.ts)
# só gera 401 — o login tem que ser de verdade (Google ou, rodando local, token).
VITE_FINANCE_MOCK=false
